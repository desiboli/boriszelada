---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Packages from '../components/Packages.astro';
import Testimonials from '../components/Testimonials.astro';
import Tips from '../components/Tips.astro';
import WhyMe from '../components/WhyMe.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBookingBar from '../components/MobileBookingBar.astro';
import { SHOW_TESTIMONIALS } from '../data/testimonials';
import { SHOW_TIPS } from '../data/tips';
---

<Layout>
  <SiteHeader />

  <main id="main">
    <Hero />
    <About />
    <Gallery />
    <QuoteBand />
    <Packages />
    {SHOW_TESTIMONIALS && <Testimonials />}
    {SHOW_TIPS && <Tips />}
    <WhyMe />
    <Contact />
  </main>

  <SiteFooter />
  <MobileBookingBar />
</Layout>
