---
import { Picture } from 'astro:assets';
import heroImage from '../assets/photos/brudpar-saden.jpg';
import { site } from '../data/site';
---

<section id="top" class="relative min-h-[100svh] overflow-hidden bg-plum">
  <Picture
    src={heroImage}
    alt="Brudpar i mörk uniform och vit klänning står tätt tillsammans i ett grönt sädesfält."
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    pictureAttributes={{ class: 'contents' }}
    class="absolute inset-0 h-full w-full object-cover object-[50%_35%]"
  />

  <!-- Two overlays: a bottom-weighted scrim for text contrast and a warm
       tint so the photo sits in the same palette as the rest of the page. -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-plum/55 via-plum/25 to-plum/85"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 bg-clay/10 mix-blend-multiply" aria-hidden="true"></div>

  <div
    class="relative mx-auto flex min-h-[100svh] max-w-[1400px] flex-col justify-end px-5 pb-16 pt-32 sm:px-8 sm:pb-20"
  >
    <p class="eyebrow reveal is-visible text-cream/75">
      <span class="whitespace-nowrap">{site.role} ·</span>{' '}
      <span class="whitespace-nowrap">{site.yearsExperience}+ år ·</span>{' '}
      <span class="whitespace-nowrap">Hela Sverige</span>
    </p>

    <h1 class="reveal is-visible mt-6 text-cream">
      <span class="script block text-4xl text-blush sm:text-5xl">Fånga</span>
      <span class="mt-1 block text-hero">de magiska</span>
      <span class="block text-hero italic text-blush">ögonblicken</span>
    </h1>

    <div
      class="reveal is-visible mt-10 flex flex-col gap-8 border-t border-cream/20 pt-8 lg:flex-row lg:items-end lg:justify-between"
    >
      <p class="max-w-xl text-lead text-cream/85">
        Tidlösa och känslofyllda bilder från er största dag — av en fotograf som
        lägger lika mycket tid på er som på bilderna.
      </p>

      <div class="flex shrink-0 flex-wrap items-center gap-3">
        <a
          href="#kontakt"
          class="whitespace-nowrap rounded-full bg-cream px-7 py-3.5 text-ink transition-transform duration-300 hover:-translate-y-0.5 hover:bg-blush"
        >
          {site.bookingLabel}
        </a>
        <a
          href="#galleri"
          class="whitespace-nowrap rounded-full border border-cream/35 px-7 py-3.5 text-cream transition-colors duration-300 hover:border-cream hover:bg-cream/10"
        >
          Se bilderna
        </a>
      </div>
    </div>
  </div>
</section>
