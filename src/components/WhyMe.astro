---
import { Picture } from 'astro:assets';
import joy from '../assets/photos/skratt-i-bilen.jpg';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

const reasons = [
  {
    title: 'Kvalitet och flexibilitet',
    body: 'Jag utmärker mig genom överlägsen kvalitet, flexibilitet och ett alltid positivt och engagerande humör — för att varje fotografering ska bli en trevlig upplevelse.',
  },
  {
    title: 'Service i toppklass',
    body: 'Genom nära samarbete med mina kunder levererar jag service i toppklass, med fokus på professionalism och personlig touch.',
  },
  {
    title: 'Era behov först',
    body: 'Som pålitlig, serviceinriktad, hjälpsam och ytterst noggrann fotograf prioriterar jag alltid era behov.',
  },
];
---

<section class="bg-forest py-24 sm:py-32">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
    <SectionHeading
      eyebrow="Varför jag?"
      script="Välj mig, välj mig!"
      title="Er dag ska kännas lätt"
      tone="light"
    />

    <div class="mt-16 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <ol class="lg:col-span-7">
        {
          reasons.map((reason, index) => (
            <li class="reveal border-t border-cream/15 py-8 first:border-t-0 first:pt-0">
              <div class="flex gap-6">
                <span class="eyebrow shrink-0 pt-2 text-gold">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="text-title text-cream">{reason.title}</h3>
                  <p class="mt-3 max-w-xl text-cream/70">{reason.body}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="reveal lg:col-span-5">
        <Picture
          src={joy}
          alt="Bruden och två anhöriga skrattar tillsammans i baksätet på bröllopsbilen."
          formats={['avif', 'webp']}
          widths={[520, 900, 1300]}
          sizes="(min-width: 1400px) 520px, (min-width: 1024px) 35vw, 90vw"
          pictureAttributes={{ class: 'contents' }}
          loading="lazy"
          class="w-full rounded-[1.75rem] object-cover"
        />
        <p class="mt-8 text-cream/75">
          Bröllopsdagen går fort. Min uppgift är att göra den lättare — att finnas där
          utan att ta plats, och att ge er bilder som känns som er.
        </p>
        <a
          href="#kontakt"
          class="mt-8 inline-block rounded-full bg-cream px-7 py-3.5 text-forest transition-colors duration-300 hover:bg-gold"
        >
          {site.bookingLabel}
        </a>
      </div>
    </div>
  </div>
</section>
