---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
import { packageOptionValue, packages } from '../data/packages';

const fieldClass =
  'w-full rounded-xl border border-ink/15 bg-cream px-4 py-3 text-ink transition-colors placeholder:text-ink/65 focus:border-clay aria-[invalid=true]:border-clay aria-[invalid=true]:ring-1 aria-[invalid=true]:ring-clay';
const labelClass = 'eyebrow block text-ink/70';
const errorClass = 'mt-2 text-sm font-semibold text-clay';
---

<section id="kontakt" class="bg-blush py-24 sm:py-32">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Vill ni veta mer?"
          script="Toppen!"
          title="Då är det dags att höras"
        />

        <p class="reveal mt-6 text-lead text-ink/75">
          Berätta lite om er dag — datum, plats och vad ni tänkt er. Jag svarar alltid
          personligen, och en första konsultation kostar ingenting.
        </p>

        <dl class="reveal mt-12 flex flex-col gap-6 border-t border-ink/15 pt-8">
          <div>
            <dt class={labelClass}>E-post</dt>
            <dd class="mt-1">
              <a
                href={`mailto:${site.email}`}
                class="font-display text-2xl text-ink underline decoration-clay decoration-2 underline-offset-4 transition-colors hover:text-clay"
              >
                {site.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class={labelClass}>Instagram</dt>
            <dd class="mt-1">
              <a
                href={site.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-display text-2xl text-ink underline decoration-clay decoration-2 underline-offset-4 transition-colors hover:text-clay"
              >
                {site.instagramHandle}
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="reveal lg:col-span-7">
        <!-- Netlify detects this form in the built HTML at deploy time; the
             name must match the hidden form-name field. -->
        <form
          id="contact-form"
          name="kontakt"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          data-email={site.email}
          class="rounded-[1.75rem] bg-cream/70 p-7 backdrop-blur-sm sm:p-10"
        >
          <input type="hidden" name="form-name" value="kontakt" />

          <p class="mb-6 text-sm text-ink/70">
            Fält markerade med <span aria-hidden="true">*</span> måste fyllas i.
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label class={labelClass} for="names">Ni två <span aria-hidden="true">*</span></label>
              <input
                class={`${fieldClass} mt-2`}
                id="names"
                name="Brudpar"
                type="text"
                required
                autocomplete="name"
                placeholder="Era namn"
              />
              <p id="names-error" class={errorClass} hidden></p>
            </div>

            <div>
              <label class={labelClass} for="email">E-post <span aria-hidden="true">*</span></label>
              <input
                class={`${fieldClass} mt-2`}
                id="email"
                name="E-post"
                type="email"
                required
                autocomplete="email"
                placeholder="namn@exempel.se"
              />
              <p id="email-error" class={errorClass} hidden></p>
            </div>

            <div>
              <label class={labelClass} for="phone">Telefon</label>
              <input
                class={`${fieldClass} mt-2`}
                id="phone"
                name="Telefon"
                type="tel"
                autocomplete="tel"
                placeholder="070 123 45 67"
              />
            </div>

            <div class="min-w-0">
              <label class={labelClass} for="date">Bröllopsdatum <span aria-hidden="true">*</span></label>
              <input class={`${fieldClass} mt-2`} id="date" name="Datum" type="date" required />
              <p id="date-error" class={errorClass} hidden></p>
            </div>

            <div>
              <label class={labelClass} for="location">Plats</label>
              <input
                class={`${fieldClass} mt-2`}
                id="location"
                name="Plats"
                type="text"
                placeholder="Ort eller lokal"
              />
            </div>

            <div class="sm:col-span-2">
              <label class={labelClass} for="package">Vilket paket är ni intresserade av?</label>
              <select
                class={`${fieldClass} mt-2 appearance-none bg-[url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2020%2020'%20fill='none'%20stroke='%232b2622'%20stroke-width='1.75'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='m5%208%205%205%205-5'/%3E%3C/svg%3E")] bg-[length:1.25rem] bg-[position:right_1rem_center] bg-no-repeat pr-12`}
                id="package"
                name="Paket"
              >
                <option value="Vet inte än">Vet inte än — hjälp oss välja</option>
                {
                  packages.map((pkg) => (
                    <option value={packageOptionValue(pkg)}>
                      {pkg.name} — {pkg.price}
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="sm:col-span-2">
              <label class={labelClass} for="message">Berätta om er dag</label>
              <textarea
                class={`${fieldClass} mt-2 min-h-36 resize-y`}
                id="message"
                name="Meddelande"
                rows="5"
                placeholder="Hur många gäster, vad är viktigast för er, och finns det något särskilt ni vill ha fångat?"></textarea>
            </div>
          </div>

          <!-- Honeypot: bots fill this in, humans never see it. -->
          <input type="text" name="bot-field" tabindex="-1" class="hidden" aria-hidden="true" />
          <input type="hidden" name="subject" value="Ny bröllopsförfrågan via boriszelada.com" />

          <button
            type="submit"
            class="mt-8 w-full rounded-full bg-ink px-8 py-4 text-cream transition-colors duration-300 hover:bg-clay disabled:opacity-60"
          >
            Skicka förfrågan
          </button>

          <p class="mt-4 text-sm text-ink/70">
            Ibland hamnar mina svar i skräpposten — lämna gärna ett telefonnummer så
            hör jag av mig där också.
          </p>

          <p class="mt-3 text-sm text-ink/70">
            Uppgifterna används bara för att svara på er förfrågan. Läs mer i min{" "}
            <a
              href="/integritetspolicy"
              class="underline decoration-clay underline-offset-2 transition-colors hover:text-clay"
            >
              integritetspolicy</a
            >.
          </p>

          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="mt-4 hidden rounded-xl px-4 py-3 text-sm"
          >
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  if (form && status) {
    const setStatus = (message: string, ok: boolean) => {
      status.textContent = message;
      status.classList.remove('hidden', 'bg-sage/20', 'bg-clay/15', 'text-ink');
      status.classList.add(ok ? 'bg-sage/20' : 'bg-clay/15', 'text-ink');
    };

    // "Fråga om …" on a package card pre-selects that package in the form.
    const packageSelect = document.getElementById('package') as HTMLSelectElement | null;
    for (const link of document.querySelectorAll<HTMLElement>('[data-package]')) {
      link.addEventListener('click', () => {
        if (packageSelect && link.dataset.package) packageSelect.value = link.dataset.package;
      });
    }

    // Replace the browser's validation bubbles with messages under each field.
    // Without JS the native validation still applies.
    form.noValidate = true;

    // Catches a mistyped year. Uses the visitor's local date, not UTC.
    const dateField = document.getElementById('date') as HTMLInputElement | null;
    if (dateField) {
      const now = new Date();
      dateField.min = new Date(now.getTime() - now.getTimezoneOffset() * 60_000)
        .toISOString()
        .slice(0, 10);
    }

    const messages: Record<string, (field: HTMLInputElement) => string> = {
      names: () => 'Skriv era namn.',
      email: (field) =>
        field.validity.valueMissing
          ? 'Skriv er e-postadress.'
          : 'Det ser inte ut som en e-postadress — kolla gärna stavningen.',
      date: (field) =>
        field.validity.rangeUnderflow
          ? 'Det datumet har redan varit — kolla gärna året.'
          : 'Välj ert bröllopsdatum. Ett ungefärligt datum går bra.',
    };

    const fields = Object.keys(messages)
      .map((id) => document.getElementById(id))
      .filter((field): field is HTMLInputElement => field instanceof HTMLInputElement);

    const validate = (field: HTMLInputElement) => {
      const error = document.getElementById(`${field.id}-error`);
      if (!error) return true;

      const valid = field.checkValidity();
      if (valid) {
        field.removeAttribute('aria-invalid');
        field.removeAttribute('aria-describedby');
        error.hidden = true;
        error.textContent = '';
      } else {
        field.setAttribute('aria-invalid', 'true');
        field.setAttribute('aria-describedby', error.id);
        error.textContent = messages[field.id](field);
        error.hidden = false;
      }
      return valid;
    };

    for (const field of fields) {
      // Only complain on blur once something has been typed, so tabbing
      // through an empty form doesn't light it up with errors.
      field.addEventListener('blur', () => {
        if (field.value !== '' || field.hasAttribute('aria-invalid')) validate(field);
      });
      field.addEventListener('input', () => {
        if (field.hasAttribute('aria-invalid')) validate(field);
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const invalid = fields.filter((field) => !validate(field));
      if (invalid.length > 0) {
        invalid[0].focus();
        return;
      }

      // The Astro dev server answers any POST with the page itself, which
      // would look like a successful submission. Only Netlify can receive it.
      if (import.meta.env.DEV) {
        setStatus(
          'Utvecklingsläge: formuläret skickas bara på Netlify-sajten. Inget har skickats.',
          false,
        );
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const original = button?.textContent ?? 'Skicka förfrågan';
      if (button) {
        button.disabled = true;
        button.textContent = 'Skickar…';
      }

      try {
        // Netlify only accepts URL-encoded bodies for form submissions.
        const body = new URLSearchParams(
          Array.from(new FormData(form), ([key, value]) => [key, String(value)]),
        );
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });

        if (!response.ok) throw new Error(String(response.status));

        form.reset();
        setStatus(
          'Tack! Er förfrågan är skickad. Jag hör av mig så snart jag kan.',
          true,
        );
      } catch {
        setStatus(
          `Något gick fel. Maila mig gärna direkt på ${form.dataset.email} i stället.`,
          false,
        );
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = original;
        }
      }
    });
  }
</script>
