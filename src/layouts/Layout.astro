---
import { Font } from 'astro:assets';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  additionalType: 'https://schema.org/Photograph',
  name: site.name,
  description: site.description,
  url: canonical.href,
  image: ogImage.href,
  email: site.email,
  jobTitle: site.role,
  areaServed: { '@type': 'Country', name: 'Sverige' },
  sameAs: [site.instagramUrl],
  priceRange: '7000–18000 SEK',
};
---

<!doctype html>
<html lang="sv" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcf8f3" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <Font cssVariable="--ff-display" preload />
    <Font cssVariable="--ff-body" preload />
    <Font cssVariable="--ff-script" />

    <script is:inline set:html={JSON.stringify(structuredData)} type="application/ld+json" />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-ink focus:px-5 focus:py-2 focus:text-cream"
    >
      Hoppa till innehåll
    </a>

    <slot />

    <script>
      // Fade sections in as they enter the viewport. Anything already on
      // screen at load is revealed immediately so the hero never flashes.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );

        for (const target of targets) observer.observe(target);
      } else {
        for (const target of targets) target.classList.add('is-visible');
      }
    </script>
  </body>
</html>
