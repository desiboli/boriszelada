---
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-plum py-16 text-cream sm:py-20">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <p class="font-display text-title">{site.name}</p>
        <p class="eyebrow mt-3 text-cream/50">{site.role} · Hela Sverige</p>
        <p class="script mt-6 text-3xl text-gold">Tack för att ni läste ända hit!</p>
      </div>

      <nav aria-label="Sidfotsmeny" class="flex flex-col gap-2.5">
        {
          nav.map((item) => (
            <a href={item.href} class="text-cream/70 transition-colors hover:text-cream">
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-col gap-2.5">
        <a
          href={`mailto:${site.email}`}
          class="text-cream/70 transition-colors hover:text-cream"
        >
          {site.email}
        </a>
        <a
          href={site.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-cream/70 transition-colors hover:text-cream"
        >
          {site.instagramHandle}
        </a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-cream/15 pt-8 text-sm text-cream/45 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}. Alla bilder tillhör fotografen.</p>
      <a href="#top" class="transition-colors hover:text-cream">Tillbaka upp &uarr;</a>
    </div>
  </div>
</footer>
