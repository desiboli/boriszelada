---
import { Image } from 'astro:assets';
import portrait from '../assets/photos/boris-portratt.jpg';
import handerna from '../assets/photos/handerna-faltet.jpg';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

const facts = [
  { value: '10+', label: 'år bakom kameran' },
  { value: 'Otaliga', label: 'ögonblick fångade' },
  { value: 'Hela', label: 'Sverige' },
];
---

<section id="om" class="bg-shell py-24 sm:py-32">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8">
    <SectionHeading eyebrow="Om mig" script="Hej!" title="Planerar ni ert bröllop?" />

    <div class="mt-16 grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-5">
        <div class="relative">
          <Image
            src={portrait}
            alt={`${site.name}, bröllopsfotograf, porträtt`}
            widths={[480, 760]}
            sizes="(min-width: 1024px) 34vw, 90vw"
            class="w-full rounded-[2rem] object-cover shadow-[0_30px_60px_-30px_rgba(34,27,25,0.35)]"
          />
          <span
            class="script absolute -bottom-5 -right-2 -rotate-3 rounded-full bg-clay px-5 py-2 text-2xl text-cream shadow-lg sm:text-3xl"
          >
            Det är jag!
          </span>
        </div>

        <dl class="mt-14 grid grid-cols-3 gap-4 border-t border-ink/15 pt-8">
          {
            facts.map((fact) => (
              <div>
                <dt class="font-display text-title text-clay">{fact.value}</dt>
                <dd class="mt-1 text-sm text-ink/65">{fact.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="reveal prose-body lg:col-span-7 lg:pt-4">
        <p class="text-lead text-ink/85">
          Jag heter <strong class="font-semibold text-ink">Boris Zelada</strong> och har
          arbetat med bröllopsfotografering i över 10 år, där jag har fångat otaliga
          minnesvärda ögonblick för par runt om i landet.
        </p>
        <p class="text-ink/75">
          Med professionell fotoutrustning och expertis inom efterredigering skapar jag
          bilder som perfekt matchar dina önskemål och visioner.
        </p>
        <p class="text-ink/75">
          För mig är en stark relation från första stund avgörande — så att du känner dig
          trygg och bekväm före, under och efter sessionen.
        </p>

        <figure class="mt-12">
          <Image
            src={handerna}
            alt="Två händer sträcker sig mot varandra över ett sädesfält, vigselringen syns tydligt."
            widths={[640, 1000, 1400]}
            sizes="(min-width: 1024px) 48vw, 90vw"
            class="w-full rounded-[1.75rem] object-cover"
          />
          <figcaption class="script mt-4 text-2xl text-clay">
            …och det är därför jag älskar det här jobbet.
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
